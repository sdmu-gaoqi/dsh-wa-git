{
  "name": "@wagq/dsh-git",
  "version": "0.3.1",
  "description": "在 DSH 会话标题栏加一枚 Git 按钮：像 VS Code 一样查看改动、提交、提交图、分支与远程、解决冲突，并支持用当前会话模型生成提交消息、内嵌 Git 终端和仓库文件浏览。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "source-control",
    "scm",
    "git-graph",
    "文件浏览"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sdmu-gaoqi/dsh-wa-git.git"
  },
  "homepage": "https://github.com/sdmu-gaoqi/dsh-wa-git#readme",
  "bugs": "https://github.com/sdmu-gaoqi/dsh-wa-git/issues",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "preview/scm-popup.png",
    "preview/scm-popup-compare.png",
    "preview/scm-popup-diff.png",
    "preview/scm-popup-terminal.png",
    "preview/scm-popup-file-text.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-native-command": "0.2.2-rc.1"
  },
  "repository": "github:sdmu-gaoqi/dsh-wa-git",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
